# Android fstab for gta9 (MediaTek, non-A/B, ext4)
#<src>                                                  <mnt_point>         <type>    <mnt_flags>                                                                         <fs_mgr_flags>

# Logical partitions (inside the 'super' partition)
system          /system             ext4      ro                                                                              wait,logical,first_stage_mount
system_ext      /system_ext         ext4      ro                                                                              wait,logical,first_stage_mount
product         /product            ext4      ro                                                                              wait,logical,first_stage_mount
vendor          /vendor             ext4      ro                                                                              wait,logical,first_stage_mount
vendor_dlkm     /vendor_dlkm        ext4      ro                                                                              wait,logical,first_stage_mount
odm             /odm                ext4      ro                                                                              wait,logical,first_stage_mount

# Physical partitions
/dev/block/by-name/userdata        /data               f2fs      noatime,nosuid,nodev,discard,inlinecrypt,fsync_mode=nobarrier    wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,latemount
/dev/block/by-name/cache           /cache              ext4      noatime,nosuid,nodev,discard                                     wait,check,formattable
/dev/block/by-name/metadata        /metadata           ext4      noatime,nosuid,nodev,discard                                     wait,check,formattable,first_stage_mount
/dev/block/by-name/misc            /misc               emmc      defaults                                                         defaults
/dev/block/by-name/boot            /boot               emmc      defaults                                                         defaults,first_stage_mount
/dev/block/by-name/vendor_boot     /vendor_boot        emmc      defaults                                                         defaults,first_stage_mount
/dev/block/by-name/recovery        /recovery           emmc      defaults                                                         defaults,first_stage_mount
/dev/block/by-name/dtbo            /dtbo               emmc      defaults                                                         defaults,first_stage_mount
/dev/block/by-name/vbmeta          /vbmeta             emmc      defaults                                                         defaults,first_stage_mount
/dev/block/by-name/vbmeta_system   /vbmeta_system      emmc      defaults                                                         defaults,first_stage_mount
/dev/block/by-name/vbmeta_vendor   /vbmeta_vendor      emmc      defaults                                                         defaults,first_stage_mount

# ZRAM
/dev/block/zram0                   none                swap      defaults                                                         zramsize=50%,max_comp_streams=8
